{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    // Every pull request is signed off under the DCO, and the DCO check reads
    // this trailer on Renovate's commits too.
    ":gitSignOff",
  ],

  // Renovate updates only the workflow actions here. The `renovate`
  // annotations on component pins serve a repository that imports the
  // component.
  "enabledManagers": ["github-actions"],
  // The pull request title check requires a typed subject, and Renovate
  // otherwise guesses the commit style from the history.
  "semanticCommits": "enabled",
  "rebaseWhen": "never",
  "timezone": "Etc/UTC",
  "schedule": ["before 6am"],
  // A week lets a compromised release be yanked before an automerge takes
  // it. Renovate holds back a release that carries no timestamp.
  "minimumReleaseAge": "7 days",

  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "groupName": "scheduled updates",
      "automerge": true,
    },
  ],
}
