schema-version 1

description "KDE, gaming and hardware support over kinoite-main"

provides {
    "rechunking"
    "graphical-session"
    "flatpak" witness="/usr/bin/flatpak"
    "just" witness="/usr/bin/just"
    "plasma-desktop" witness="/usr/bin/plasmashell"
    "package-manager/dnf5" witness="/usr/bin/dnf5"
}

imports "fedora/build-environment" "identity"

base "ghcr.io/ublue-os/bazzite:$version" {
    family "fedora"
    bootloader "grub2"
    scap-content "ssg-fedora-ds.xml"
}

option "version" type="string" {
    default "stable"
}
