schema-version 1

description "GNOME developer workstation over silverblue-main"

provides {
    "rechunking"
    "graphical-session"
    "flatpak" witness="/usr/bin/flatpak"
    "gnome-desktop" witness="/usr/bin/gnome-shell"
    "just" witness="/usr/bin/just"
    "package-manager/dnf5" witness="/usr/bin/dnf5"
}

imports "fedora/build-environment" "identity"

base "ghcr.io/ublue-os/bluefin:$version" {
    family "fedora"
    bootloader "grub2"
    scap-content "ssg-fedora-ds.xml"
}

option "version" type="string" {
    default "stable"
}
