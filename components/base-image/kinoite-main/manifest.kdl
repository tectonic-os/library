schema-version 1

description "Fedora Kinoite with the ublue additions"

provides {
    "rechunking"
    "graphical-session"
    "flatpak" witness="/usr/bin/flatpak"
}

imports "fedora/build-environment" "package-manager/dnf5" "identity"

base "ghcr.io/ublue-os/kinoite-main:$version" {
    family "fedora"
    bootloader "grub2"
    scap-content "ssg-fedora-ds.xml"
}

option "version" type="string" {
    default "44"
}
