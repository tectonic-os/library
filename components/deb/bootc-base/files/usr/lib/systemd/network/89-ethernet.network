# This is systemd's `89-ethernet.network.example` unchanged. Debian configures
# no network link, so an installed machine has no address without this file.
# `Kind=!*` keeps podman's bridges and veths from taking a lease.
[Match]
Kind=!*
Type=ether

[Network]
DHCP=yes
