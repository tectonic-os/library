schema-version 1

description "Installs media codecs from the repository the repo option selects."

targets "fedora"

option "repo" type="string" {
    description "The repository component under repos/ that the codecs come from."
    default "fedora"
}

imports "repos/$repo"

network "scripts"

requires "build-environment"

on "fedora" {
    packages {
        "libva-utils"
        "pipewire-config-raop"
        "pipewire-gstreamer"
        "pipewire-utils"
    }
}
