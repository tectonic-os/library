schema-version 1

description "Full media codec set from negativo17, replacing the base image's stripped ffmpeg"

targets "fedora"

network "scripts"

requires "build-environment"

on "fedora" {
    packages {
        "ffmpeg"
        "ffmpeg-libs"
        "libva-utils"
        "pipewire-config-raop"
        "pipewire-gstreamer"
        "pipewire-libs-extra"
        "pipewire-utils"
    }
}
