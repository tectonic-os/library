-a always,exit -F arch=b32 -S rename -S renameat -S renameat2 -S rmdir -S unlink -S unlinkat -F auid>=1000 -F auid!=unset -F key=delete
-a always,exit -F arch=b64 -S rename -S renameat -S renameat2 -S rmdir -S unlink -S unlinkat -F auid>=1000 -F auid!=unset -F key=delete
