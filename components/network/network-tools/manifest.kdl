schema-version 1

description "Network tooling: avahi, wireguard-tools, tcpdump, traceroute and friends"

targets "fedora" "debian" "ubuntu"

// Three renames, resolved 2026-09-05: `avahi-utils` is `avahi-tools`,
// `gir1.2-avahi-0.6` is the GObject introspection data `avahi-gobject`
// carries, and `netcat-openbsd` is what provides `nc` on both deb families
// (`ncat` also resolves, and is not the default `nc` there).
packages "cifs-utils" "tcpdump" "traceroute" "wireguard-tools"

on "fedora" { packages "avahi-gobject" "avahi-tools" "nmap-ncat" }
on "debian" "ubuntu" {
    packages "gir1.2-avahi-0.6" "avahi-utils" "netcat-openbsd"
}
