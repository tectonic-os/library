# A bootc machine's /usr is read-only and its packages come from the image, so
# apt updating itself on a timer can only fail or, worse, half-succeed.
# dpkg-db-backup writes the admindir to /var/backups, which is a copy of state
# that now lives under /usr and travels with the image anyway.
disable apt-daily.timer
disable apt-daily-upgrade.timer
disable dpkg-db-backup.timer

# `finalize.sh` removes the `multi-user.target.wants/ssh.service` symlink the
# `openssh-server` postinst writes, and that is enough for every boot that is
# not a first boot. It is not enough for one that is: systemd runs `preset-all`
# then, and a unit no preset file names is *enabled* by the built-in default —
# measured 2026-09-02, `Applying preset policy` followed by `Created symlink
# '/etc/systemd/system/sockets.target.wants/ssh.socket'`, and the machine
# listened on 22 having been told not to. A removal cannot survive that and a
# policy line can. `login-access` enables `ssh.service` and never the socket,
# so this line has nothing to argue with.
disable ssh.socket

# The BLS entries bootc writes have no reader on a deb GRUB — `blscfg` is
# Fedora's command and the signed image loads no modules under Secure Boot — so
# the menu is rendered from them instead. The path unit is what keeps an
# upgrade bootable: `bootc upgrade` stages a new entry and the menu is
# rewritten before anyone reboots into it.
enable grub-menu-from-bls.service
enable grub-menu-from-bls.path

# The boot partition mounted where bootc reads it. Its own conditions decide
# whether it runs, so enabling it on a layout that does not need it is a no-op
# rather than a wrong mount — which is why this is unconditional here.
enable sysroot-boot.mount

# And made writable, because bootc writes its BLS entries through that bind and
# it inherits `ro` from the `/boot` bootc itself mounts read-only. Without this
# `bootc upgrade` dies on `Writing BLS entries to disk: Read-only file system`
# — measured 2026-09-04 — and the unit's own `ConditionPathIsMountPoint` is
# what keeps it off a layout where /boot lives inside the root filesystem.
enable sysroot-boot-rw.service

# Debian enables `systemd-resolved` from the package postinst and enables
# nothing that configures a link, so without this line an installed machine has
# no address and `bootc upgrade` cannot reach a registry — measured 2026-09-04,
# `failure in name resolution` on a machine installed from media, with `ip` not
# installed to diagnose it. `systemd-networkd` is already present as part of
# systemd, so this line plus `89-ethernet.network` is the whole of the fix.
#
# An image that installs NetworkManager keeps this line and loses the
# `.network`, which `finalize.sh` removes: networkd has four socket units that
# land in `failed` if it is stopped from running at all.
enable systemd-networkd.service
