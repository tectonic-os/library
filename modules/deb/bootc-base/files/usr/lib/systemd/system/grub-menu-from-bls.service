[Unit]
Description=Render the GRUB menu from the BLS entries
ConditionPathIsDirectory=/boot/loader/entries

# The renderer writes to `/sysroot/boot/grub2/custom.cfg`, where bootc keeps the
# entries, and that mount is read-only until `sysroot-boot-rw.service` has made
# it writable — so this is an ordering the render needs, not a courtesy. It is
# also the *only* thing the script depends on now that it no longer remounts
# anything itself. `After=` alone: on a `bootc install to-disk` layout that
# service is skipped by its own condition, and there is nothing to wait for
# because the physical boot is already writable there.
After=sysroot-boot-rw.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/grub-menu-from-bls

[Install]
WantedBy=multi-user.target
