#!/bin/sh
# Renders the BLS entries into a GRUB menu, because no deb GRUB can read
# them itself: `blscfg` is Fedora's command and `blsuki.mod` ships as a module
# the signed image does not carry and cannot load, since Secure Boot prohibits
# loading any module at all.
#
# Written to custom.cfg, the extension point bootupd's own static config
# already sources, so nothing here fights bootupd for grub.cfg. Entries are
# ordered by BLS sort-key, which is what decides the default: bootc gives the
# newest deployment the lowest one.
#
# POSIX shell and `sort`, deliberately: the deb families' default awk is mawk,
# which has neither ENDFILE nor the escapes a menu needs quoting with.
# Takes an optional root: the units pass none and render this machine's own
# physical boot, and an installer passes the target it still has mounted, because
# nothing renders the menu during an install — bootupd runs before the entries
# are written. The paths *inside* the menu are the BLS entry's own and are
# absolute against the filesystem GRUB reads, so a prefix here never reaches
# them.
set -eu

root="${1:-}"

# **The physical boot directory, which is `/sysroot/boot` and not `/boot`.**
# That is where bootc reads and writes its entries — `physical_root.open_dir(
# "boot")`, `store/mod.rs:392` — and it is the one mount `sysroot-boot-rw.service`
# leaves writable. `/boot` is the deployment's read-only *view* of the same
# filesystem, mounted `ro` by bootc's own `systemd.mount-extra=…:/boot:auto:ro`
# karg; writing the menu through it is what used to need a remount here, and
# the remount is what made this script depend on superblock-versus-per-mount
# flag semantics. Writing where bootc writes deletes the whole question.
#
# Measured 2026-09-05 on the D4 machine, which is what settles it:
# `mount -o remount,rw /boot` left `bootc upgrade` failing identically, and only
# `mount -o remount,rw /sysroot/boot` let it through.
#
# An installer passes its target root and has it mounted writable already, so
# `${root}/boot` is right there and `/sysroot` means nothing.
boot="${root:-/sysroot}/boot"

# The one arrangement in which everything below silently does nothing. On the
# separate-/boot layout `sysroot-boot.mount` binds the partition at
# /sysroot/boot; if it did not run, bootc writes its entries into an empty
# directory on the physical root, GRUB reads a boot partition nothing has
# touched, and this script exits 0 on the missing `grub2` — three components
# agreeing to do nothing and no message anywhere. Refuse instead, because a
# machine whose menu is never rewritten is the defect this whole file exists
# for. It should never fire: the service is ordered after the mount.
if [ -z "$root" ] && mountpoint -q /boot && ! mountpoint -q /sysroot/boot; then
    echo "grub-menu-from-bls: /boot is its own partition but /sysroot/boot is not bound to it, so bootc and this script disagree about where the entries are; sysroot-boot.mount did not run" >&2
    exit 1
fi

entries="${boot}/loader/entries"
staged="${boot}/loader/entries.staged"
grubdir="${boot}/grub2"
out="${grubdir}/custom.cfg"

# **`bootc upgrade` never writes to `loader/entries`.** It writes the next
# boot's menu to `loader/entries.staged` and starts
# `bootc-finalize-staged.service`, whose `ExecStop` renames the one over the
# other at *shutdown* — `bootc_composefs/boot.rs:901`, "This will be atomically
# renamed to 'loader/entries' on shutdown/reboot", and `service.rs:13` for the
# `systemctl start` that arms it. So GRUB reads a menu rendered from the
# *previous* entries on the way back up, and the machine boots the old
# deployment while looking perfectly healthy.
#
# Measured 2026-09-04: an upgrade landed, the reboot took the old deployment,
# and across that whole boot the renderer had run exactly once — at startup,
# before bootc wrote anything. A `.path` unit on `loader/entries` cannot win
# that race; there is nothing to watch until it is too late to matter.
#
# Rendering from the staged directory closes it, and is exact rather than a
# guess: the same code writes *both* entries there, the new deployment at
# `FILENAME_PRIORITY_PRIMARY` and the currently booted one at `SECONDARY`, so it
# is the whole of the next menu and not a fragment of it.
#
# A cancelled upgrade needs nothing special. `update.rs:82` removes the staged
# directory, the `.path` unit sees that removal like any other change, and this
# falls back to `entries` on the next render.
#
# **An empty staged directory is left alone rather than fallen back on.** bootc
# creates it and then writes both `.conf` files microseconds later, so the watch
# fires once on the bare directory: falling back to `entries` there renders the
# *old* menu, and only the next render — milliseconds away — corrects it.
# Measured 2026-09-05, four times in five. Nothing observed it, but the file
# being rewritten is the boot menu, and exiting is free. The fallback still
# applies where the staged directory does not exist at all, which is the
# cancelled-upgrade case.
if [ -d "$staged" ]; then
    staged_holds_entry=
    for conf in "$staged"/*.conf; do
        if [ -f "$conf" ]; then
            staged_holds_entry=yes
        fi
        break
    done
    [ -n "$staged_holds_entry" ] || exit 0
    entries="$staged"
fi

[ -d "$entries" ] || exit 0
[ -d "$grubdir" ] || exit 0

fields() {
    for conf in "$entries"/*.conf; do
        [ -f "$conf" ] || continue
        title=''
        kernel=''
        initrd=''
        options=''
        sort_key=''
        while read -r key value; do
            case "$key" in
                title) title="$value" ;;
                linux) kernel="$value" ;;
                initrd) initrd="$value" ;;
                options) options="$value" ;;
                sort-key) sort_key="$value" ;;
            esac
        done < "$conf"
        # An entry with no kernel is not one; skipping it is what keeps a
        # half-written file from emptying the menu.
        [ -n "$kernel" ] || continue
        printf '%s\t%s\t%s\t%s\t%s\n' \
            "${sort_key:-${conf##*/}}" "${title:-${conf##*/}}" \
            "$kernel" "$initrd" "$options"
    done | sort
}

tmp="${out}.new"
: > "$tmp"
n=0
fields | while IFS="$(printf '\t')" read -r _ title kernel initrd options; do
    # `if`, not `&&`: a false test ends an AND-list non-zero, and `set -e`
    # would take that as the whole render failing on the second entry.
    if [ "$n" -eq 0 ]; then
        printf "set default='bls-0'\n" >> "$tmp"
    fi
    printf "menuentry '%s' --id 'bls-%s' {\n" "$title" "$n" >> "$tmp"
    printf '  linux %s %s\n' "$kernel" "$options" >> "$tmp"
    if [ -n "$initrd" ]; then
        printf '  initrd %s\n' "$initrd" >> "$tmp"
    fi
    printf '}\n' >> "$tmp"
    n=$((n + 1))
done

if [ ! -s "$tmp" ]; then
    rm -f "$tmp"
    echo "no usable BLS entry under ${entries}" >&2
    exit 1
fi
mv -f "$tmp" "$out"
