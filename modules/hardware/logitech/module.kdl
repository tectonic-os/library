description "Solaar rules for Logitech wireless peripherals"

supports "fedora" "debian" "ubuntu"

// Fedora splits the udev rules out as `solaar-udev`; neither deb family does,
// so the deb leg installs the whole of Solaar to get them. Checked 2026-09-05:
// there is no udev-only binary package on either.
family "fedora" { packages "solaar-udev" }
family "debian" "ubuntu" { packages "solaar" }
