schema-version 1

description "Xbox controller support: the xone driver, built and signed for the running kernel"

supports "fedora"

network "scripts"

requires "kernel-devel"
requires "secureboot-key" "kernel-devel-helpers"

arg "KERNEL"
secret "mok_privkey"

asset "xone" {
    pin {
        renovate datasource="git-refs" depName="https://github.com/medusalix/xone"
        version "3484f603484782dd7551c64e5a33fc602b127051"
        url "https://github.com/medusalix/xone.git"
    }
}
