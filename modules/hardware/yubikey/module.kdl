description "Hardware token and smartcard auth: YubiKey, FIDO2, PAM and PC/SC"

supports "fedora" "debian" "ubuntu"

requires "build-environment"

// `apparmor/usr.sbin.pcscd` is taken only where the image has that MAC, the way
// a `packages` batch is taken for the base's family, so no `requires` names it:
// this module works unconfined, and the profile is what the deb families add.
// Debian's own `apparmor-profiles` ships none for pcscd — checked 2026-09-01 —
// so nothing here overrides an upstream one.
//
// Ubuntu was held back for two reasons and both are discharged. The
// `path-exclude` answer is `deb/build-environment`, which deletes
// `/etc/dpkg/dpkg.cfg.d/excludes` and reinstalls every package against it
// before any module installs anything — measured 2026-09-03, `man1` 0 -> 459
// pages. And the leg exists now. The whole Debian set resolves on
// `ubuntu:26.04` unchanged, checked 2026-09-05.
packages "opensc" "pamu2fcfg" "yubikey-manager"

family "fedora" {
    packages "pam-u2f" "pam_yubico" "pcsc-lite" "pcsc-lite-ccid"
}
family "debian" "ubuntu" {
    packages "libpam-u2f" "libpam-yubico" "pcscd" "libccid"
}
