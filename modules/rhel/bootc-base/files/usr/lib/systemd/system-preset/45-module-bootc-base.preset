# EL's own `90-default.preset` enables `sshd.service`, so an image from this
# base would listen on the network because a package said so. `login-access` is
# the module that decides it, and its preset sorts after this one.
disable sshd.service
disable sshd.socket

# A composefs root is read-only, so /tmp is a tmpfs or nothing can write it:
# `bootc status` fails creating its SELinux probe there. EL's presets leave the
# unit disabled; `almalinux-bootc:10` enables it.
enable tmp.mount
