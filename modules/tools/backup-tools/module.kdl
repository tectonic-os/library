description "Backup and sync tooling: borgbackup, restic and rclone"

supports "fedora" "debian" "ubuntu"

// `rclone` does not resolve on `debian:forky` — checked 2026-09-05, and the
// base configures `main` only, with no `contrib` and no `non-free-firmware`.
// Ubuntu carries it in `universe`, which that base does configure. So the
// Debian image gets two of the three and the absence is stated here rather
// than found at build time.
packages "borgbackup" "restic"

family "fedora" "ubuntu" { packages "rclone" }
