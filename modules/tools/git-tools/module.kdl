description "Git and its companions: git-delta, git-lfs, and the direnv that rides along"

supports "fedora" "debian" "ubuntu"

// `git-credential-libsecret` has no deb binary on either family. Checked
// 2026-09-05: `dpkg -L git` on `debian:forky` ships only the C source under
// `/usr/share/doc/git/contrib/credential/libsecret`, and no other package
// builds it. So the name is dropped rather than translated, and a deb image
// gets `git-credential-cache` and `git-credential-store`, which `git` does
// ship.
packages "direnv" "git" "git-delta" "git-lfs"

family "fedora" { packages "git-credential-libsecret" }
