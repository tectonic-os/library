+    /// The two shared-memory regions the guest maps, by id: the window and the
+    /// UVM aperture. QEMU asks for these on attach and fails to realize the
+    /// device if the request errors, which the trait's default does. The
+    /// index is the id the guest looks up, so the entries are sparse.
+    fn get_shmem_config(&self) -> std::io::Result<VhostUserShMemConfig> {
+        let mut cfg = VhostUserShMemConfig::default();
+        cfg.nregions = NV_SHM_ID_APERTURE as u32 + 1;
+        cfg.memory_sizes[NV_SHM_ID as usize] = NV_WINDOW_LEN;
+        cfg.memory_sizes[NV_SHM_ID_APERTURE as usize] = NV_APERTURE_LEN;
+        Ok(cfg)
+    }
