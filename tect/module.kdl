description "tect itself, so a booted image answers for its own build with no repository; pinned separately from the tect-version that built it"

supports "fedora"

network "scripts"

provides "tect"
provides "tect-assets" file="/usr/share/tectonic/assets"

asset "tect" {
    pin {
        renovate datasource="github-releases" depName="tectonic-os/tectonic"
        version "0.6.31"
        url "https://github.com/tectonic-os/tectonic/releases/download/v{version}/tect-v{version}-x86_64-linux-musl.tar.gz"
        sha256 "6d6c4be96aa8ab9636714955f31d68c2ba16a1e5ac864e188649b81083275199" from="sidecar"
    }
}
